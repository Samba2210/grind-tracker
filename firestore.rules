rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Player profiles (name, colour, small avatar image)
    match /players/{id} {
      allow read: if true;
      allow write: if id in ['p1', 'p2', 'p3', 'p4']
        && request.resource.data.keys().hasOnly(['name', 'color', 'avatar', 'team'])
        && (!('team' in request.resource.data) || request.resource.data.team in ['t1', 't2'])
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 16))
        && (!('avatar' in request.resource.data) || (request.resource.data.avatar is string && request.resource.data.avatar.size() < 200000));
    }

    // Teams (name, colour)
    match /teams/{id} {
      allow read: if true;
      allow write: if id in ['t1', 't2']
        && request.resource.data.keys().hasOnly(['name', 'color'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 20;
    }

    // Challenges (bets between players)
    match /challenges/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['from', 'to', 'stake', 'desc', 'deadline', 'status', 'createdAt'])
        && request.resource.data.from in ['p1', 'p2', 'p3', 'p4']
        && request.resource.data.to in ['p1', 'p2', 'p3', 'p4']
        && request.resource.data.from != request.resource.data.to
        && request.resource.data.stake is number
        && request.resource.data.stake > 0
        && request.resource.data.stake <= 100000
        && request.resource.data.desc is string
        && request.resource.data.desc.size() > 0
        && request.resource.data.desc.size() <= 100
        && request.resource.data.deadline is string
        && request.resource.data.deadline.size() <= 10
        && request.resource.data.status == 'pending';
      // only status moves forward: pending -> active/declined/cancelled, active -> completed/failed
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'proof', 'resolvedAt'])
        && ((resource.data.status == 'pending' && request.resource.data.status in ['active', 'declined', 'cancelled'])
          || (resource.data.status == 'active' && request.resource.data.status in ['completed', 'failed']))
        && (!('proof' in request.resource.data) || (request.resource.data.proof is string && request.resource.data.proof.size() <= 60));
      allow delete: if false;
    }

    // Activities
    match /activities/{id} {
      allow read, delete: if true;
      allow create: if request.resource.data.playerId in ['p1', 'p2', 'p3', 'p4']
        && request.resource.data.type in ['run', 'cycle', 'swim']
        && request.resource.data.km is number
        && request.resource.data.km > 0
        && request.resource.data.km <= 1000
        && request.resource.data.date is string
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 80;
      allow update: if false;
    }
  }
}
